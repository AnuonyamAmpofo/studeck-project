PORT=4000

# Supabase Postgres connection string — use the "Session pooler" version
# (Connect panel > Direct tab > Connection Method > Session pooler), not the
# direct connection, unless you're on an IPv4 add-on network.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# Claude API key for AI quiz generation (https://console.anthropic.com)
ANTHROPIC_API_KEY=
